module bitcoin_node_module {
  version "0.2.0"
  depends []

  method list_networks() -> tstr description "`{ ok, networks }`: mainnet, testnet4 and signet, and regtest when the instance directory\nholds regtest.json."
  method config_status() -> tstr description "`{ ok, state: unconfigured|unready|configured, configured, unconfigured, proxySet, walletOpen,\ntorUse, torUseChosen }`, the last two by network name."
  method init_defaults() -> tstr description "Fills what is absent: the Tor proxy, and each network's sources (Kyoto on, one Electrum\nserver for fee rates but on signet, every other source off). `{ ok, applied }`. Backend only."
  method get_sources(network: tstr) -> tstr description "`{ ok, network, configured, walletOpen, proxy, torUse, torUseChosen, sources: [{ id, kind, url, operator, label, use,\nhistory, tor, lan, hasCredentials, certSha256, route, suspect }], exposes, withoutTor }`; no credential."
  method set_sources(network: tstr, list_json: tstr) -> tstr description "Replaces the list (a JSON array of sources); answers as get_sources. A source's\n`certSha256` (TLS servers only) is kept when absent and cleared by null. Plain tcp:// or\nhttp:// to a public host, and an `esplora` entry, are refused with `invalid parameters: …`.\nAt most one node (`local` or `rpc`) may be on. Backend only; refused while a wallet is open\non `network`."
  method set_source(network: tstr, source_id: tstr, changes_json: tstr) -> tstr description "Changes one source: `{ use?, history?, tor?, certSha256? }`. tor: false is refused for an\nonion service. certSha256 pins the server's end-entity certificate (64 hex characters,\ncolons allowed; ssl:// or https:// only); null or \"\" clears it. Answers as get_sources.\nBackend only; refused while a wallet is open."
  method set_proxy(proxy: tstr) -> tstr description "The Tor proxy for every source: `tor`, the Tor that comes with Logos (the default), or the\nuser's own at socks5h://host:port; empty clears it, which leaves every source routed\nthrough Tor without a route. Backend only; refused while a wallet is open."
  method set_tor_use(network: tstr, mode: tstr) -> tstr description "What Tor carries on `network`: `all`, `identifying` (headers and filters direct, matched\nblocks and broadcasts over Tor) or `none` (Tor off, onion sources unrouted); it sets that\nnetwork's `torUseChosen`. `{ ok, network, torUse, torUseChosen }`. Backend only; refused\nwhile any wallet is open."
  method set_wallet_open(network: tstr, open: bool) -> tstr description "Whether a wallet is open on `network`, which locks its settings. Backend only."
  method route_table(network: tstr) -> tstr description "`{ ok, network, proxy, chain, history, pending, fees, broadcast, check, peers, unrouted,\ntorUse, kyotoSplit }`, each role `[{ id, kind, url, operator, route: tor|direct|onion, credentials?,\ncertSha256?, userAdded? }]`, `peers` `[{ peer: \"host:port\", source: list|learned|seed|own, ok,\nservices? }]` (`ok`: it ever worked; `services` for clearnet peers). `kyotoSplit`, in\n`identifying` only: `{ chain: { route: direct, peers }, tor: { route: onion, peers } }`.\nBackend and wallet core."
  method report_mismatch(network: tstr, source_id: tstr, kind: tstr, height: tstr) -> tstr description "Marks a source suspect until the backend clears it; `height` decimal, or empty.\nBackend and wallet core."
  method clear_suspect(network: tstr, source_id: tstr) -> tstr description "`{ ok, network, sourceId, cleared }`. Backend only."
  method peer_list(network: tstr) -> tstr description "`{ ok, network, list: { format, network, version, created, date, note, peers },\nownPeers, usable, counts: { list, learned, seed, usable, okLast30d },\nroute, kyotoTor, torUse, clearnet: { list, usable, counts } }`; `usable` as route_table's\n`peers`; `clearnet` null on regtest."
  method set_own_peers(network: tstr, peers_json: tstr) -> tstr description "The user's own Kyoto peers (a JSON array of host[:port]), which replace the list; `[]`\ngoes back to it. Answers as peer_list. Backend only; refused while a wallet is open."
  method report_peers(network: tstr, report_json: tstr) -> tstr description "What Kyoto saw: `{ outcomes: [{ peer, ok, reason? }], learned: [{ addr, port, services,\nseenAt, from }] }`, at most 500 of each. An outcome updates the peer's record; the third\nfailure in a row skips it for 24 h. A learned peer is kept if it is onion v3, or a public\nIP address at most 2 per /16 or /32 (on regtest, on your network), with bits 0, 3 and 6,\nseen within 3 days. `{ ok, network, outcomes:\n{ applied, unknown }, learned: { added, updated, refused }, counts }`. Wallet core only."
  method source_health(network: tstr) -> tstr description "`{ ok, network, overall, pending, sources: [{ id, kind, state, tipHeight, tipHash, rttMs,\nroute, checkedAt, error, serverVersion, suspect, certificate?, ... }], tor, torUse, torUseChosen }`\nfrom address-free calls only. `tor` is the built-in Tor's `{ state, progress, detail, socks,\nanswered }` while the proxy is it and Tor is used, else null; `answered` is false until tor_module answers. A TLS server's `certificate` is `{ certSha256, subject, issuer, notBefore,\nnotAfter, trusted }`, also when untrusted, for the app to offer pinning it."
  method probe(network: tstr, source_id: tstr) -> tstr description "Probes `source_id` now, or every enabled server when empty, then answers as\nsource_health plus `answered`, within 15 s."
  method local_node(network: tstr) -> tstr description "`{ ok, network, enabled, available, status?, error? }` from bitcoind_module, when loaded."
  method source_credentials(network: tstr, source_id: tstr) -> tstr description "`{ ok, network, sourceId, username, password }` of an RPC server. Wallet core only."

  event source_health_changed(network: tstr, payload: tstr) description "source_health()'s reply, when anything but round-trip times changed."
  event routes_changed(network: tstr) description "route_table(network) would now answer differently."
  event source_suspect(network: tstr, source_id: tstr, kind: tstr)
}
